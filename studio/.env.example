# Port du studio
PORT=3000

# URL publique du studio (sans / final). En local : http://localhost:3000
# Doit correspondre à l'URL de redirection déclarée dans ton app LinkedIn :
#   <PUBLIC_URL>/auth/linkedin/callback
PUBLIC_URL=http://localhost:3000

# Mot de passe du tableau de bord (fortement conseillé dès que le studio est en ligne)
# Identifiant : n'importe lequel, mot de passe : celui-ci
APP_PASSWORD=

# App LinkedIn (https://www.linkedin.com/developers/apps)
# Produits à activer : "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Version de l'API LinkedIn (format AAAAMM)
LINKEDIN_VERSION=202510

# Fuseau horaire d'affichage
TZ=Europe/Paris
