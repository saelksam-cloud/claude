# Variables à définir dans Netlify (Project configuration > Environment variables)

# Mot de passe du tableau de bord (obligatoire)
APP_PASSWORD=

# App LinkedIn (https://www.linkedin.com/developers/apps)
# Produits : "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# URL de redirection à déclarer : https://<ton-site>.netlify.app/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facultatif
LINKEDIN_VERSION=202510
# PUBLIC_URL=https://studio.mondomaine.fr   (par défaut : l'URL Netlify du site)
